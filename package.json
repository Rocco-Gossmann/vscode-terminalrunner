{
  "name": "terminalrunner",
  "displayName": "Terminal Runner",
  "description": "A tool that helps VSCode to interact with its Terminal",
  "version": "0.1.0",
  "publisher": "rocco-gossmann",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "runner"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [ ],
    "configuration": {
      "title": "Terminal Runner",
      "properties": {
        "terminalrunner.terminals": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "object",
              "properties": {
                "terminalName": { "type": "string" },
                "startCommand": { "type": "string" },
              },
              "required": [
                "terminalName",
                "startCommand"
              ],
              "additionalProperties": false
            }
          },
          "description": "Configure terminal commands"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4"
  },
  "license": "GLWTS",
  "repository": {
    "type": "git",
    "url": "https://github.com/rocco-gossmann/vscode-terminalrunner.git"
  }
}
